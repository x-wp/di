{
  "name": "x-wp/di-e2e-modern-plugin",
  "description": "Isolated current-checkout dependency fixture for WordPress coexistence tests",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-only",
  "require": {
    "php": ">=8.1 <8.5",
    "automattic/jetpack-autoloader": "5.0.1",
    "x-wp/di": "2.0.0-beta.1"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../../../..",
      "options": {
        "symlink": true,
        "reference": "none",
        "versions": {
          "x-wp/di": "2.0.0-beta.1"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "XWP\\DI\\E2E\\Modern\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "automattic/jetpack-autoloader": true
    },
    "classmap-authoritative": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  }
}
